<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Meteor.World</RootNamespace>
    <AssemblyName>World Server</AssemblyName>
    <MeteorIni>world_config.ini</MeteorIni>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common Class Lib\Common Class Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cyotek.CircularBuffer" Version="1.2.1" />
    <PackageReference Include="MySql.Data" Version="$(MySqlDataVersion)" />
    <PackageReference Include="NLog" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NLog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

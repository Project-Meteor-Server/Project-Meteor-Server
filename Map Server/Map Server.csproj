<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Meteor.Map</RootNamespace>
    <AssemblyName>Map Server</AssemblyName>
    <MeteorIni>map_config.ini</MeteorIni>
  </PropertyGroup>

  <ItemGroup>
    <!-- Legacy/unfinished files that were never part of the old project's compile list. -->
    <Compile Remove="DataObjects\database\DBWorld.cs" />
    <Compile Remove="Packets\Send\Actor\Battle\BattleAction.cs" />
    <Compile Remove="Packets\Send\Actor\Battle\BattleActionX10Packet.cs" />
    <Compile Remove="Packets\Send\Actor\Battle\BattleActionX18Packet.cs" />
    <Compile Remove="Packets\Send\Actor\Inventory\SetInitialEquipmentPacket.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common Class Lib\Common Class Lib.csproj" />
    <ProjectReference Include="..\ThirdParty\XLua\XLua.csproj" />
    <ProjectReference Include="..\Navigation\Meteor.Navigation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotRecast.Detour" Version="2026.3.1" />
    <PackageReference Include="MySql.Data" Version="$(MySqlDataVersion)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NLog.config" CopyToOutputDirectory="PreserveNewest" />
    <!-- Runtime data the map server reads from its working directory. -->
    <None Include="..\Data\scripts\**\*" Link="scripts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Built from game data, so kept out of git. -->
    <None Include="..\Data\navmesh\*.bin;..\Data\navmesh\*.nav" Link="navmesh\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Data\navmesh\manifest.json" Link="navmesh\manifest.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\Data\navmesh\manifest.json')" />
    <None Include="..\Data\collision\**\*.xcol;..\Data\collision\**\*.json" Link="collision\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Data\staticactors.bin" Link="staticactors.bin" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\Data\staticactors.bin')" />
  </ItemGroup>

  <!-- Copies the Lua library (libxlua.dylib, libxlua.so or xlua.dll, built from ThirdParty/XLuaNative) next to
       the server. It picks the one for the platform being published to, or else this machine's. -->
  <PropertyGroup>
    <XluaRid>$(RuntimeIdentifier)</XluaRid>
    <XluaRid Condition="'$(XluaRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</XluaRid>
    <XluaNativeDir>..\ThirdParty\XLuaNative\runtimes\$(XluaRid)\native\</XluaNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(XluaNativeDir)*xlua.*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="WarnMissingXlua" BeforeTargets="Build" Condition="!Exists('$(XluaNativeDir)')">
    <Warning Text="No native xlua library for $(XluaRid) in ThirdParty/XLuaNative/runtimes; build it with cmake (see ThirdParty/XLuaNative/README.md)." />
  </Target>
</Project>
